{
  "$schema": "http://json.schemastore.org/package",
  "name": "pr-preview-action",
  "version": "0.1.1",
  "private": true,
  "description": "Tooling for the pr-preview-action repository.",
  "author": "open-resource-discovery",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint:staged": "lint-staged",
    "prettier": "prettier --write \"**/*.{mjs,json,yml,yaml,md}\"",
    "prettier:ci": "prettier --check \"**/*.{mjs,json,yml,yaml,md}\"",
    "prepare": "is-ci || husky",
    "setup:hooks": "is-ci || husky",
    "build:worker": "esbuild .internal-tools/trusted-preview.mjs --bundle --platform=node --format=esm --target=node20 --outfile=.internal-tools/trusted-preview.bundle.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "test:worker": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "esbuild": "0.28.2",
    "yazl": "3.3.1"
  },
  "lint-staged": {
    "**/*.{mjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@11.21.3",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.20.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": false
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
