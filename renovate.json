{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Keep the GitHub Enterprise Server upload helper on the v3 Node 20 release line.",
      "matchFileNames": [".internal-actions/upload-artifact-v3-node20/action.yml"],
      "matchPackageNames": ["actions/upload-artifact"],
      "allowedVersions": "/^v?3(\\.\\d+){0,2}-node20$/"
    }
  ]
}
